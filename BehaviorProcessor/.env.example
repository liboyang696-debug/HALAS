# WebSocket listeners
HALAS_WS_HOST=0.0.0.0
HALAS_WS_PORT=8765
HALAS_FRONTEND_PORT=8766

# Cloud API credentials
QWEN_API_KEY=
DEEPSEEK_API_KEY=
LANYI_API_KEY=

# Locally hosted model services
HALAS_ENABLE_IMAGE2TEXT=0
HALAS_ENABLE_TINY_MODEL=0
HALAS_IMAGE2TEXT_API_URL=http://127.0.0.1:8000/caption
HALAS_TINY_MODEL_API_URL=http://127.0.0.1:8000/insight

# Optional overrides after task-specific calibration
# HALAS_TOKEN_ALPHA=0.3
# HALAS_TOKEN_THRESHOLD=-0.084277861379087

# Optional local AR detector; weights are not included
# HALAS_YOLO_MODEL_PATH=/absolute/path/to/yolo26n.pt
# HALAS_YOLO_DEVICE=cpu
